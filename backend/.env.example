PORT=3000
NODE_ENV=development

# Atlas: mongodb+srv://<usuario>:<password>@<cluster>/<base>
MONGODB_URI=

# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Uno distinto por entorno (local y Render)
BETTER_AUTH_SECRET=

# URL publica del FRONT: el navegador llega al back por el proxy /api
# Local: http://localhost:5173 · Render: https://<front>.onrender.com
BETTER_AUTH_URL=http://localhost:5173

# OAuth App de GitHub (una para local y otra para produccion)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Solo para npm run seed: contraseñas de los usuarios de prueba
SEED_ADMIN_EMAIL=admin@pelis.app
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=user@pelis.app
SEED_USER_PASSWORD=
